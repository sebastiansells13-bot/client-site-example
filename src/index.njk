---
layout: layouts/page.njk
title: Home
eleventyNavigation:
  key: Home
  order: 1
---
<div class="hero hero--photo">
  <img class="hero__bg" src="/img/hero/harbor-light-hero.jpg" alt="" width="1920" height="900">
  <div class="hero__content wrapper">
    <h1>{{ business.name }}</h1>
    <p>{{ business.tagline }}</p>
  </div>
</div>

<section class="services-grid wrapper">
  {% for service in services.list %}
  <div class="service-card">
    {% if service.icon %}<img src="{{ service.icon }}" alt="" class="service-card__icon">{% endif %}
    <h3>{{ service.title }}</h3>
    <p>{{ service.description }}</p>
  </div>
  {% endfor %}
</section>
